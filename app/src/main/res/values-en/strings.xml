    <string name="about_version_full">Version %1$s (%2$d)</string>
    <string name="about_tagline">Weather forecast and precipitation radar for Czechia</string>
    <string name="about_author_title">Author and contact</string>
    <string name="about_author_name">Ondřej Kisiala</string>
    <string name="about_contact_text">Send feedback, ideas for improvements and update requests by e-mail:</string>
    <string name="about_contact_subject">Počasí app</string>
    <string name="about_sources_title">Data sources</string>
    <string name="about_forecast_title">Weather forecast</string>
    <string name="about_forecast_text">ALADIN numerical model of the Czech Hydrometeorological Institute (CHMI) for about 3 days, extended by the global ECMWF IFS model. Data provided by Open-Meteo (model chmi_aladin_seamless), free for non-commercial use. Place search: Open-Meteo Geocoding based on GeoNames data.</string>
    <string name="about_forecast_attribution">Weather data by Open-Meteo.com, source CHMI and ECMWF, places GeoNames. Licence CC BY 4.0.</string>
    <string name="about_radar_title">Precipitation radar</string>
    <string name="about_radar_text">CHMI radar composites (maximum reflectivity, a new image every 5 minutes) from the CHMI open data portal.</string>
    <string name="about_radar_attribution">Source: CHMI, opendata.chmi.cz. Licence CC BY 4.0.</string>
    <string name="about_map_title">Base map</string>
    <string name="about_map_text">OpenFreeMap map tiles and styles (Positron, Dark) in the OpenMapTiles schema, rendered with MapLibre. Map data comes from the OpenStreetMap project.</string>
    <string name="about_map_attribution">OpenFreeMap, © OpenMapTiles, data © OpenStreetMap contributors. Licence ODbL.</string>
    <string name="about_link_open_meteo">Open-Meteo</string>
    <string name="about_link_cc_by">CC BY 4.0</string>
    <string name="about_link_chmi_opendata">CHMI open data</string>
    <string name="about_link_openfreemap">OpenFreeMap</string>
    <string name="about_link_openmaptiles">OpenMapTiles</string>
    <string name="about_link_osm_copyright">© OpenStreetMap</string>
    <string name="about_changes">Data modifications: the weather icon and description are derived from cloud cover and precipitation; radar images are cropped to the area with data and made transparent outside precipitation.</string>
    <string name="about_libraries_title">Open-source libraries</string>
    <string name="about_libraries_text">Jetpack Compose, AndroidX, Kotlin Coroutines and Serialization, Retrofit, OkHttp (Apache 2.0) · MapLibre Android (BSD 2-Clause)</string>
    <string name="about_disclaimer">This is not an official CHMI app. The forecast and radar are for guidance only; official warnings are issued by CHMI.</string>
