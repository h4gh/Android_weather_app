    <string name="about_forecast_title">Předpověď počasí</string>
    <string name="about_forecast_text">Numerický model ALADIN Českého hydrometeorologického ústavu (ČHMÚ) na zhruba 3 dny, dál doplněný globálním modelem ECMWF IFS. Data poskytuje služba Open-Meteo (model chmi_aladin_seamless) zdarma pro nekomerční použití. Vyhledávání míst: Open-Meteo Geocoding nad daty GeoNames.</string>
    <string name="about_forecast_attribution">Weather data by Open-Meteo.com, zdroj ČHMÚ a ECMWF, místa GeoNames. Licence CC BY 4.0.</string>
    <string name="about_radar_title">Radar srážek</string>
    <string name="about_radar_text">Radarové kompozity ČHMÚ (maximální odrazivost, nový snímek každých 5 minut) z portálu otevřených dat ČHMÚ.</string>
    <string name="about_radar_attribution">Zdroj: ČHMÚ, opendata.chmi.cz. Licence CC BY 4.0.</string>
    <string name="about_map_title">Mapové podklady</string>
    <string name="about_map_text">Mapové dlaždice a styly OpenFreeMap (Positron, Dark) ve schématu OpenMapTiles, vykreslené knihovnou MapLibre. Mapová data pocházejí z projektu OpenStreetMap.</string>
    <string name="about_map_attribution">OpenFreeMap, © OpenMapTiles, data © přispěvatelé OpenStreetMap. Licence ODbL.</string>
    <string name="about_link_open_meteo">Open-Meteo</string>
    <string name="about_link_cc_by">CC BY 4.0</string>
    <string name="about_link_chmi_opendata">Otevřená data ČHMÚ</string>
    <string name="about_link_openfreemap">OpenFreeMap</string>
    <string name="about_link_openmaptiles">OpenMapTiles</string>
    <string name="about_link_osm_copyright">© OpenStreetMap</string>
    <string name="about_changes">Úpravy dat: ikona a popis počasí se odvozují z oblačnosti a srážek, radarové snímky jsou oříznuté na oblast s daty a zprůhledněné mimo srážky.</string>
    <string name="about_libraries_title">Open-source knihovny</string>
    <string name="about_libraries_text">Jetpack Compose, AndroidX, Kotlin Coroutines a Serialization, Retrofit, OkHttp (Apache 2.0) · MapLibre Android (BSD 2-Clause)</string>
    <string name="about_disclaimer">Nejde o oficiální aplikaci ČHMÚ. Předpověď a radar slouží jen pro orientaci, oficiální výstrahy vydává ČHMÚ.</string>
